<mxfile>
    <diagram name="Декомпозиция A2 - Управление мини-таблицей и согласование" id="12345678-1234-1234-1234-123456789015">
        <mxGraphModel dx="1426" dy="881" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="827" pageHeight="1169">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- Основной блок A2 -->
                <mxCell id="a2_main" value="&lt;b&gt;A2: Управление мини-таблицей и согласование&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="350" y="50" width="200" height="60" as="geometry"/>
                </mxCell>
                
                <!-- Подпроцессы A2 -->
                <mxCell id="a2_1" value="&lt;b&gt;A2.1: Просмотр мини-таблицы&lt;/b&gt;&lt;br&gt;• Отображение заявок, отсортированных по дате&lt;br&gt;• Автоматическое выделение ошибок (светло-красный фон)&lt;br&gt;• Фильтрация и навигация" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="50" y="150" width="220" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="a2_2" value="&lt;b&gt;A2.2: Редактирование заявок&lt;/b&gt;&lt;br&gt;• Прямое редактирование в таблице&lt;br&gt;• Выпадающее меню нормализации адресов&lt;br&gt;• Сохранение изменений в реальном времени" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="300" y="150" width="220" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="a2_3" value="&lt;b&gt;A2.3: Принятие решений&lt;/b&gt;&lt;br&gt;• Одобрение заявок&lt;br&gt;• Отклонение с возможностью указания причины&lt;br&gt;• Запрос корректных данных у сотрудника" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="550" y="150" width="220" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="a2_4" value="&lt;b&gt;A2.4: Слияние с основной БД&lt;/b&gt;&lt;br&gt;• Полное слияние всей мини-таблицы&lt;br&gt;• Автоматическое очищение мини-таблицы&lt;br&gt;• Ручной запуск процесса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="200" y="280" width="220" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="a2_5" value="&lt;b&gt;A2.5: Автоматические уведомления&lt;/b&gt;&lt;br&gt;• Уведомления об изменении статуса&lt;br&gt;• Групповые уведомления (n новых заявок)&lt;br&gt;• Запросы на исправление данных" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="450" y="280" width="220" height="100" as="geometry"/>
                </mxCell>
                
                <!-- Входы для A2 -->
