                <!-- Основной блок A3 -->
                <mxCell id="a3_main" value="&lt;b&gt;A3: Формирование итоговых данных&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="350" y="50" width="200" height="60" as="geometry"/>
                </mxCell>
                
                <!-- Подпроцессы A3 -->
                <mxCell id="a3_1" value="&lt;b&gt;A3.1: Накопление и фильтрация данных&lt;/b&gt;&lt;br&gt;• Прием заявок из A2&lt;br&gt;• Фильтрация по рабочему дню (6:00-5:59)&lt;br&gt;• Сортировка по дате и времени" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="50" y="150" width="200" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="a3_2" value="&lt;b&gt;A3.2: Генерация Excel-файла&lt;/b&gt;&lt;br&gt;• Формирование по установленному формату&lt;br&gt;• Группировка по дате и времени&lt;br&gt;• Создание предпросмотра" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="300" y="150" width="200" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="a3_3" value="&lt;b&gt;A3.3: Предоставление и скачивание&lt;/b&gt;&lt;br&gt;• Отображение предпросмотра&lt;br&gt;• Скачивание руководителем&lt;br&gt;• Подтверждение получения" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="550" y="150" width="200" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="a3_4" value="&lt;b&gt;A3.4: Резервное копирование&lt;/b&gt;&lt;br&gt;• Автоматическое каждые 2 часа&lt;br&gt;• Хранение 24 часа&lt;br&gt;• Контроль целостности" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
