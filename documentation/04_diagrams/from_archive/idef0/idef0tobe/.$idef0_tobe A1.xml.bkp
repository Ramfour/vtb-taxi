                <!-- Основной блок A1 -->
                <mxCell id="a1_main" value="&lt;b&gt;A1: Прием и нормализация заявок&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
