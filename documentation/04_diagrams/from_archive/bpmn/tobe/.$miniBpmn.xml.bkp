<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.2.8 Chrome/140.0.7339.240 Electron/38.4.0 Safari/537.36" version="28.2.8">
  <diagram name="BPMN - Процесс заказа такси (горизонтальная, корректные шлюзы)" id="BPMN_Taxi_Fixed">
    <mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Пул: Сотрудник -->
        <mxCell id="pool_employee" value="Сотрудник" style="swimlane;whiteSpace=wrap;html=1;horizontal=1;startSize=30;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="pool_employee">
          <mxGeometry x="30" y="50" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="send_request" value="Подать заявку через мессенджер-бота" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_employee">
          <mxGeometry x="120" y="45" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Пул: Система -->
        <mxCell id="pool_system" value="Автоматизированная система" style="swimlane;whiteSpace=wrap;html=1;horizontal=1;startSize=30;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="Валидация данных" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_system">
          <mxGeometry x="80" y="75" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="normalize" value="Нормализация адреса (геокодер)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_system">
          <mxGeometry x="240" y="75" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="save_mini" value="Сохранить в мини-таблицу" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_system">
          <mxGeometry x="440" y="75" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notify_manager" value="Уведомить руководителя" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_system">
          <mxGeometry x="630" y="75" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Пул: Руководитель -->
        <mxCell id="pool_manager" value="Руководитель" style="swimlane;whiteSpace=wrap;html=1;horizontal=1;startSize=30;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1300" height="280" as="geometry" />
        </mxCell>
        <mxCell id="view_requests" value="Просмотр заявок в веб-интерфейсе" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_manager">
          <mxGeometry x="80" y="115" width="170" height="50" as="geometry" />
        </mxCell>
        <!-- Первый шлюз (разветвление) -->
        <mxCell id="gateway_split" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pool_manager">
          <mxGeometry x="290" y="105" width="70" height="70" as="geometry" />
        </mxCell>
        <!-- Ветви -->
        <mxCell id="approve" value="Одобрить" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_manager">
          <mxGeometry x="420" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="Отклонить" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_manager">
          <mxGeometry x="420" y="115" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edit" value="Редактировать" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_manager">
          <mxGeometry x="420" y="210" width="100" height="50" as="geometry" />
        </mxCell>
        <!-- Действия после одобрения и отклонения -->
        <mxCell id="move_to_db" value="Перенос в основную БД" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_manager">
          <mxGeometry x="580" y="20" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notify_reject" value="Уведомить сотрудника (причина)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_manager">
          <mxGeometry x="580" y="115" width="150" height="50" as="geometry" />
        </mxCell>
        <!-- Второй шлюз (слияние) -->
        <mxCell id="gateway_join" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pool_manager">
          <mxGeometry x="780" y="105" width="70" height="70" as="geometry" />
        </mxCell>
        <!-- Конец основного процесса -->
        <mxCell id="end_main" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="pool_manager">
          <mxGeometry x="900" y="115" width="40" height="40" as="geometry" />
        </mxCell>
        <!-- Редактирование возвращается к первому шлюзу -->
        <mxCell id="edit_loop" value="Внести правки" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_manager">
          <mxGeometry x="580" y="210" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- Пул: Автоматическое формирование отчета -->
        <mxCell id="pool_report" value="Формирование отчета (автоматически)" style="swimlane;whiteSpace=wrap;html=1;horizontal=1;startSize=30;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="Таймер (конец рабочего дня)" style="shape=clock;whiteSpace=wrap;html=1;" vertex="1" parent="pool_report">
          <mxGeometry x="100" y="45" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="generate_report" value="Сформировать итоговый Excel-файл" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_report">
          <mxGeometry x="280" y="45" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notify_report" value="Уведомить руководителя" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_report">
          <mxGeometry x="510" y="45" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="manager_download" value="Скачать / загрузить исправленный файл" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="pool_report">
          <mxGeometry x="720" y="45" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end_report" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="pool_report">
          <mxGeometry x="960" y="45" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Связи -->
        <!-- Сотрудник -> система -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="send_request" target="validate" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Система: цепочка -->
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="validate" target="normalize" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="normalize" target="save_mini" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="save_mini" target="notify_manager" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Система -> руководитель -->
        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="notify_manager" target="view_requests" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Руководитель: просмотр -> первый шлюз -->
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="view_requests" target="gateway_split" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- От шлюза к трём ветвям -->
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="gateway_split" target="approve" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="gateway_split" target="reject" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="gateway_split" target="edit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Одобрено: действие и переход ко второму шлюзу -->
        <mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="approve" target="move_to_db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="move_to_db" target="gateway_join" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Отклонено: действие и переход ко второму шлюзу -->
        <mxCell id="edge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="reject" target="notify_reject" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="notify_reject" target="gateway_join" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Редактирование: действие и возврат к первому шлюзу -->
        <mxCell id="edge14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="edit" target="edit_loop" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" parent="1" source="edit_loop" target="gateway_split" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Слияние шлюз -> конечное событие -->
        <mxCell id="edge16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="gateway_join" target="end_main" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Формирование отчета: линейная цепочка -->
        <mxCell id="edge17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="timer" target="generate_report" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="generate_report" target="notify_report" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="notify_report" target="manager_download" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" source="manager_download" target="end_report" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Подписи -->
        <mxCell id="label_split" value="Выбор&#xa;действия" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="290" y="480" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="label_join" value="Слияние&#xa;потоков" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="780" y="480" width="70" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>